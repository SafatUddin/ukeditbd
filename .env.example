# Supabase / PostgreSQL pooled connection string (used at runtime)
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
# Supabase / PostgreSQL session pooler or direct connection string (used by Prisma CLI)
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"

# Direct SMTP email alerts to Admin on manual bKash orders (e.g. Gmail SMTP + App Password — no third-party email API)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="ukeditbd@gmail.com"
SMTP_PASS=""

# Manual bKash Send Money number shown at checkout (used while SSLCommerz is pending/in progress)
NEXT_PUBLIC_BKASH_NUMBER="01XXX-XXXXXX"

# SSLCommerz Payment Gateway (supports bKash, Nagad, Rocket, Visa, Mastercard)
# Free sandbox account: https://developer.sslcommerz.com/registration/
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
# Set to "true" in production with live merchant credentials; "false" for sandbox
SSLCOMMERZ_IS_LIVE="false"
# Public base URL of your deployed site (e.g. https://ukeditbd.vercel.app)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
